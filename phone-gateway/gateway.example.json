{
  "port": 3000,
  "publicUrl": "http://localhost:3000",
  "apiKeys": ["change-me-to-a-long-random-api-key"],
  "webhookSecret": "change-me-to-a-long-random-webhook-secret",
  "ari": { "url": "http://127.0.0.1:8088", "user": "gateway", "password": "gateway-dev-secret", "app": "gateway" },
  "rtpHost": "127.0.0.1",
  "trunkDialString": "PJSIP/{number}@trunk",
  "recordingsDir": "./asterisk/.run/spool/recording",
  "numbers": {
    "+15550100": {
      "verbs": [{ "connect": { "url": "ws://localhost:8080/call", "protocol": "native" } }, { "hangup": {} }]
    },
    "+15550101": { "url": "https://your-app.example.com/voice", "format": "twiml", "statusCallback": "https://your-app.example.com/status" },
    "default": { "verbs": [{ "play": { "media": "sound:hello-world" } }, { "hangup": {} }] }
  }
}
