{
  "name": "phone-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted programmable voice gateway: SIP calls via Asterisk, controlled from TypeScript with JSON verbs or TwiML, bridged to WebSocket apps such as the voice agent.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "asterisk": "asterisk/start.sh",
    "start": "tsx src/main.ts",
    "test": "tsx --test --test-timeout=60000 test/*.test.ts",
    "test:unit": "tsx --test --test-timeout=20000 test/unit-*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
